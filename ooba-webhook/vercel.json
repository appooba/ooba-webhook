{
  "version": 2,
  "routes": [
    {
      "src": "/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/aprender",
      "dest": "/api/aprender.js"
    },
    {
      "src": "/api/followup",
      "dest": "/api/followup.js"
    },
    {
      "src": "/api/followup_funil",
      "dest": "/api/followup_funil.js"
    },
    {
      "src": "/api/reativar",
      "dest": "/api/reativar.js"
    },
    {
      "src": "/api/registrar_prospeccao",
      "dest": "/api/registrar_prospeccao.js"
    },
    {
      "src": "/api/importar",
      "dest": "/api/importar.js"
    },
    {
      "src": "/api/prospectar",
      "dest": "/api/prospectar.js"
    },
    {
      "src": "/api/gerente_pipeline",
      "dest": "/api/gerente_pipeline.js"
    }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/aprender.js": {
      "maxDuration": 60
    },
    "api/gerente_pipeline.js": {
      "maxDuration": 60
    },
    "api/prospectar.js": {
      "maxDuration": 60
    }
  }
}